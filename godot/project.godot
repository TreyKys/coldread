; COLD READ — Godot 4 production project.
; Engine configuration file. See BUILD_PLAN.md for the full architecture.
config_version=5

[application]

config/name="COLD READ"
config/description="Brick-voxel detective / crime game. Act 1 — The Kites."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

; Order matters: Mirror registers before GameState (GameState.load restores Mirror).
Mirror="*res://autoload/mirror.gd"
GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio.gd"

[display]

; Landscape, always. The greybox was portrait; that was a prototype shortcut.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/resizable=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

; gl_compatibility runs on cheap 3GB Androids (ROADMAP § Destruction on cheap phones).
; Switch to "mobile" (Vulkan) per-device once the art pass lands.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.063, 0.075, 1)
